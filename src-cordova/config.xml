<?xml version='1.0' encoding='utf-8'?>
<widget id="com.listall" version="0.3.0-alpha" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>ListAll</name>
    <description>Aplicativo para gerenciamento de listas 3 em 1</description>
    <author email="jonataslimafsa@gmail.com" href="mailto:jonataslimafsa@gmail.com">
        Jonatas Lima
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="about:*" />
    <icon src="res/checklist.png" />
    <platform name="android">
        <icon src="res/checklist.png" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="android-compileSdkVersion" value="36" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/checklist.png" />
        <preference name="SplashMaintainAspectRatio" value="true" />
        <preference name="SplashShowOnlyFirstTime" value="false" />
        <preference name="SplashScreen" value="screen" />
    </platform>
</widget>
